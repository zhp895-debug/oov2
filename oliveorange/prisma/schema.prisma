datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Item {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  category            String
  subCategory         String?
  unit                String
  brand               String?
  minStock            Float    @default(0)
  maxStock            Float    @default(0)
  reorderLevel        Float    @default(0)
  storageLocation     String?
  shelfRack           String?
  primarySupplierId   String?
  primarySupplierName String?
  purchaseRate        Float    @default(0)
  avgRate             Float    @default(0)
  batchTracking       Boolean  @default(false)
  expiryTracking      Boolean  @default(false)
  status              String   @default("active")
  description         String?
  createdDate         DateTime @default(now())
  updatedDate         DateTime @updatedAt

  transactions            InventoryTransaction[]
  transferItems           StockTransferItem[]
  requisitionItems        PurchaseRequisitionItem[]
  purchaseOrderItems      PurchaseOrderItem[]
  grnItems                GoodsReceivedNoteItem[]
  purchaseReturnItems     PurchaseReturnItem[]
  recipeOutputs           Recipe[]                  @relation("RecipeOutputItem")
  recipeItems             RecipeItem[]
  productionPlanItems     ProductionPlanItem[]
  kitchenRequestItems     KitchenRequestItem[]
  productionIngredients   ProductionIngredient[]
  productionWastages      ProductionWastage[]
}

model Store {
  id            String  @id @default(uuid())
  code          String  @unique
  name          String
  type          String
  location      String
  managerName   String?
  inCharge      String?
  contactNumber String?
  isMainStore   Boolean @default(false)
  status        String  @default("active")

  transactions          InventoryTransaction[]
  transfersFrom         StockTransfer[]           @relation("TransfersFrom")
  transfersTo           StockTransfer[]           @relation("TransfersTo")
  requisitions          PurchaseRequisition[]
  purchaseOrders        PurchaseOrder[]
  grns                  GoodsReceivedNote[]
  purchaseReturns       PurchaseReturn[]
  productionPlans       ProductionPlan[]
  kitchenRequests       KitchenRequest[]
  productionRecords     ProductionRecord[]
}

model Supplier {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  gstin         String?
  category      String?
  status        String   @default("active")
  rating        Float    @default(5.0)
  paymentTerms  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  suggestedRequisitions PurchaseRequisitionItem[]
  purchaseOrders        PurchaseOrder[]
  grns                  GoodsReceivedNote[]
  purchaseReturns       PurchaseReturn[]
}

model InventoryTransaction {
  id              String    @id @default(uuid())
  itemId          String
  storeId         String
  locationId      String?
  transactionType String // INVENTORY_OPENING, PURCHASE_IN, TRANSFER_IN, TRANSFER_OUT, CONSUMPTION_OUT, WASTAGE_OUT, PURCHASE_RETURN_OUT, ADJUSTMENT_IN, ADJUSTMENT_OUT, REVERSAL
  quantity        Float // Always positive in record
  unitId          String
  rate            Float?
  totalValue      Float?
  batchNumber     String?
  expiryDate      DateTime?
  referenceType   String?
  referenceId     String?
  remarks         String?
  status          String    @default("POSTED")
  createdBy       String
  createdAt       DateTime  @default(now())

  item  Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([storeId])
  @@index([locationId])
  @@index([transactionType])
  @@index([createdAt])
  @@index([batchNumber])
  @@index([expiryDate])
}

model StockTransfer {
  id             String    @id @default(uuid())
  transferNumber String    @unique
  fromStoreId    String
  fromLocationId String?
  toStoreId      String
  toLocationId   String?
  status         String    @default("REQUESTED") // REQUESTED, APPROVED, DISPATCHED, RECEIVED, COMPLETED, CANCELLED
  requestedBy    String
  approvedBy     String?
  dispatchedAt   DateTime?
  receivedAt     DateTime?
  remarks        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  fromStore Store @relation("TransfersFrom", fields: [fromStoreId], references: [id])
  toStore   Store @relation("TransfersTo", fields: [toStoreId], references: [id])

  items StockTransferItem[]

  @@index([status])
  @@index([createdAt])
}

model StockTransferItem {
  id          String    @id @default(uuid())
  transferId  String
  itemId      String
  quantity    Float
  unitId      String
  batchNumber String?
  expiryDate  DateTime?

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model PurchaseRequisition {
  id                String    @id @default(uuid())
  requisitionNumber String    @unique
  requestedBy       String
  storeId           String
  requiredDate      DateTime?
  priority          String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status            String    @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED, CANCELLED
  remarks           String?
  approvedBy        String?
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id])
  items PurchaseRequisitionItem[]
  purchaseOrders PurchaseOrder[]

  @@index([status])
  @@index([createdAt])
}

model PurchaseRequisitionItem {
  id                  String  @id @default(uuid())
  requisitionId       String
  itemId              String
  requestedQuantity   Float
  unitId              String
  suggestedSupplierId String?
  remarks             String?

  requisition       PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  item              Item                @relation(fields: [itemId], references: [id])
  suggestedSupplier Supplier?           @relation(fields: [suggestedSupplierId], references: [id])
}

model PurchaseOrder {
  id                   String    @id @default(uuid())
  poNumber             String    @unique
  supplierId           String
  storeId              String
  requisitionId        String?
  orderDate            DateTime  @default(now())
  expectedDeliveryDate DateTime?
  paymentTerms         String?
  subtotal             Float     @default(0)
  discount             Float     @default(0)
  taxAmount            Float     @default(0)
  shippingAmount       Float     @default(0)
  grandTotal           Float     @default(0)
  status               String    @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, SENT, PARTIALLY_RECEIVED, FULLY_RECEIVED, CANCELLED, CLOSED
  createdBy            String
  approvedBy           String?
  approvedAt           DateTime?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  supplier    Supplier             @relation(fields: [supplierId], references: [id])
  store       Store                @relation(fields: [storeId], references: [id])
  requisition PurchaseRequisition? @relation(fields: [requisitionId], references: [id])

  items           PurchaseOrderItem[]
  grns            GoodsReceivedNote[]
  purchaseReturns PurchaseReturn[]

  @@index([status])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id               String  @id @default(uuid())
  purchaseOrderId  String
  itemId           String
  orderedQuantity  Float
  unitId           String
  unitPrice        Float
  discount         Float   @default(0)
  taxRate          Float   @default(0)
  taxAmount        Float   @default(0)
  lineTotal        Float
  receivedQuantity Float   @default(0)
  pendingQuantity  Float
  remarks          String?

  purchaseOrder PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          Item                    @relation(fields: [itemId], references: [id])
  grnItems      GoodsReceivedNoteItem[]
}

model GoodsReceivedNote {
  id              String    @id @default(uuid())
  grnNumber       String    @unique
  purchaseOrderId String
  supplierId      String
  storeId         String
  locationId      String?
  receivedDate    DateTime  @default(now())
  invoiceNumber   String?
  invoiceDate     DateTime?
  vehicleNumber   String?
  receivedBy      String
  qualityStatus   String    @default("PENDING") // PENDING, PASSED, PARTIAL, FAILED
  status          String    @default("DRAFT") // DRAFT, PENDING_INSPECTION, INSPECTED, PENDING_APPROVAL, APPROVED, REJECTED, CANCELLED
  subtotal        Float     @default(0)
  taxAmount       Float     @default(0)
  grandTotal      Float     @default(0)
  remarks         String?
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  store         Store         @relation(fields: [storeId], references: [id])

  items           GoodsReceivedNoteItem[]
  purchaseReturns PurchaseReturn[]

  @@index([status])
  @@index([createdAt])
}

model GoodsReceivedNoteItem {
  id                  String    @id @default(uuid())
  grnId               String
  purchaseOrderItemId String?
  itemId              String
  orderedQuantity     Float     @default(0)
  receivedQuantity    Float
  acceptedQuantity    Float
  rejectedQuantity    Float     @default(0)
  unitId              String
  unitPrice           Float
  batchNumber         String?
  expiryDate          DateTime?
  rejectionReason     String?
  remarks             String?

  grn               GoodsReceivedNote  @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  item              Item               @relation(fields: [itemId], references: [id])
}

model PurchaseReturn {
  id              String   @id @default(uuid())
  returnNumber    String   @unique
  supplierId      String
  purchaseOrderId String?
  grnId           String?
  storeId         String
  returnDate      DateTime @default(now())
  reason          String
  status          String   @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, COMPLETED, CANCELLED
  createdBy       String
  approvedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier      Supplier           @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  grn           GoodsReceivedNote? @relation(fields: [grnId], references: [id])
  store         Store              @relation(fields: [storeId], references: [id])

  items PurchaseReturnItem[]

  @@index([status])
  @@index([createdAt])
}

model PurchaseReturnItem {
  id               String  @id @default(uuid())
  purchaseReturnId String
  itemId           String
  quantity         Float
  unitId           String
  batchNumber      String?
  reason           String?
  rate             Float
  totalValue       Float

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  item           Item           @relation(fields: [itemId], references: [id])
}

model SystemSetting {
  id                         String   @id @default("default")
  allowNegativeStock         Boolean  @default(false)
  enableFefo                 Boolean  @default(true)
  allowOverReceiving         Boolean  @default(false)
  allowPartialKitchenIssue   Boolean  @default(true)
  trackFinishedGoods         Boolean  @default(false)
  productionVarianceThreshold Float    @default(5.0)
  wastageThreshold           Float    @default(5000)
  expiryWarningDays          Int      @default(15)
  updatedAt                  DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  user        String
  role        String
  action      String
  module      String
  description String
  itemId      String?
  quantity    Float?
  storeId     String?
  reference   String?
  timestamp   DateTime @default(now())
}

model Recipe {
  id                String   @id @default(uuid())
  recipeCode        String   @unique
  name              String
  description       String?
  outputItemId      String?
  outputQuantity    Float
  outputUnitId      String
  yieldQuantity     Float?
  wastagePercentage Float    @default(0)
  version           Int      @default(1)
  status            String   @default("ACTIVE") // DRAFT, ACTIVE, INACTIVE, ARCHIVED
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  outputItem        Item?                @relation("RecipeOutputItem", fields: [outputItemId], references: [id])
  items             RecipeItem[]
  productionPlans   ProductionPlan[]
  productionRecords ProductionRecord[]

  @@index([status])
  @@index([createdAt])
}

model RecipeItem {
  id                String  @id @default(uuid())
  recipeId          String
  itemId            String
  quantity          Float
  unitId            String
  wastagePercentage Float   @default(0)
  isOptional        Boolean @default(false)
  sequenceNumber    Int?
  remarks           String?

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  item   Item   @relation(fields: [itemId], references: [id])
}

model ProductionPlan {
  id              String    @id @default(uuid())
  planNumber      String    @unique
  productionDate  DateTime
  storeId         String
  recipeId        String
  recipeVersion   Int       @default(1)
  plannedQuantity Float
  unitId          String
  status          String    @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, IN_PROGRESS, COMPLETED, CANCELLED
  createdBy       String
  approvedBy      String?
  approvedAt      DateTime?
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store Store  @relation(fields: [storeId], references: [id])
  recipe Recipe @relation(fields: [recipeId], references: [id])

  items             ProductionPlanItem[]
  kitchenRequests   KitchenRequest[]
  productionRecords ProductionRecord[]

  @@index([status])
  @@index([createdAt])
}

model ProductionPlanItem {
  id                String  @id @default(uuid())
  productionPlanId  String
  itemId            String
  requiredQuantity  Float
  unitId            String
  availableQuantity Float   @default(0)
  shortageQuantity  Float   @default(0)
  remarks           String?

  productionPlan ProductionPlan @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  item           Item           @relation(fields: [itemId], references: [id])
}

model KitchenRequest {
  id               String    @id @default(uuid())
  requestNumber    String    @unique
  productionPlanId String?
  storeId          String
  requestedBy      String
  status           String    @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, ISSUED, PARTIALLY_ISSUED, CANCELLED
  approvedBy       String?
  approvedAt       DateTime?
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  productionPlan ProductionPlan? @relation(fields: [productionPlanId], references: [id])
  store          Store           @relation(fields: [storeId], references: [id])

  items             KitchenRequestItem[]
  productionRecords ProductionRecord[]

  @@index([status])
  @@index([createdAt])
}

model KitchenRequestItem {
  id                String  @id @default(uuid())
  requestId         String
  itemId            String
  requestedQuantity Float
  approvedQuantity  Float   @default(0)
  issuedQuantity    Float   @default(0)
  unitId            String
  remarks           String?

  kitchenRequest KitchenRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item           Item           @relation(fields: [itemId], references: [id])
}

model ProductionRecord {
  id               String    @id @default(uuid())
  productionNumber String    @unique
  productionPlanId String?
  kitchenRequestId String?
  recipeId         String
  recipeVersion    Int       @default(1)
  storeId          String
  plannedQuantity  Float
  actualQuantity   Float
  unitId           String
  productionDate   DateTime  @default(now())
  status           String    @default("STARTED") // STARTED, COMPLETED, CANCELLED
  startedAt        DateTime?
  completedAt      DateTime?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  productionPlan ProductionPlan? @relation(fields: [productionPlanId], references: [id])
  kitchenRequest KitchenRequest? @relation(fields: [kitchenRequestId], references: [id])
  recipe         Recipe          @relation(fields: [recipeId], references: [id])
  store          Store           @relation(fields: [storeId], references: [id])

  ingredients ProductionIngredient[]
  wastages    ProductionWastage[]

  @@index([status])
  @@index([createdAt])
}

model ProductionIngredient {
  id                 String  @id @default(uuid())
  productionRecordId String
  itemId             String
  expectedQuantity   Float
  actualQuantity     Float
  unitId             String
  varianceQuantity   Float   @default(0)
  variancePercentage Float   @default(0)
  remarks            String?

  productionRecord ProductionRecord @relation(fields: [productionRecordId], references: [id], onDelete: Cascade)
  item             Item             @relation(fields: [itemId], references: [id])
}

model ProductionWastage {
  id                 String   @id @default(uuid())
  productionRecordId String
  itemId             String
  quantity           Float
  unitId             String
  reason             String
  estimatedValue     Float    @default(0)
  createdBy          String
  createdAt          DateTime @default(now())

  productionRecord ProductionRecord @relation(fields: [productionRecordId], references: [id], onDelete: Cascade)
  item             Item             @relation(fields: [itemId], references: [id])
}
